# Copy this file to ".env" (same folder) and fill in YOUR values. Never commit ".env" and never share it.
# Atlas: Connect > Drivers > copy the connection string. Special characters in the password must be URL-encoded.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/gamerift?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173
# The backend's own public address. SSLCommerz calls back to this URL, so a live demo
# needs a public tunnel/production address here (localhost only works for local calls).
BACKEND_URL=http://localhost:9090
# The admin account created on the first start (password at least 8 characters)
ADMIN_EMAIL=admin@gamerift.tech
ADMIN_PASSWORD=ChangeMe123!
# Secret used to sign login tokens (JWT). At least 32 characters. Generate one in PowerShell:
#   $b = New-Object byte[] 48; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# Token lifetime in milliseconds (3600000 = 1 hour)
JWT_EXPIRATION=3600000
# ---- E-mail (OTP codes and password reset) ----
# console = the e-mails are only printed in the IntelliJ console (good for testing). brevo = really send them.
MAIL_MODE=console
# Only needed for MAIL_MODE=brevo: Brevo > SMTP & API > API keys. MAIL_FROM_EMAIL must be a verified sender in Brevo.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Gamerift
# ---- Payments (SSLCommerz sandbox) ----
# Collect store_id / store_passwd from the SSLCommerz sandbox merchant panel.
# Sandbox is free and moves no real money. Never commit or share the real values.
SSLCOMMERZ_BASE_URL=https://sandbox.sslcommerz.com
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_SANDBOX=true
